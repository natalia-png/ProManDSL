project Acta_plataforma_HE_Arquitectos {

  metadata {
    code        PRJ_001
    version     v1_0
    created_on  2025_11_20
    prepared_by Juan_Pablo_Castaneda
  }

  client {
    name    HE_Arquitectos
    contact Arq_Natalia_Rubio
    email   contacto@he-arq.com
  }

  context {
    summary Plataforma_integral_para_gestionar_proyectos_arquitectonicos_en_tiempo_real.
  }

  objectives {
    general  Mejorar_la_coordinacion_y_trazabilidad_de_los_proyectos_arquitectonicos.
    specific Centralizar_la_informacion_de_proyectos.
    specific Facilitar_la_comunicacion_entre_arquitectos_e_ingenieros.
    specific Automatizar_generacion_de_reportes_y_actas.
  }

  scope {
    include Gestion_de_fases_del_proyecto.
    include Seguimiento_de_entregables_y_responsables.
    include Registro_de_riesgos_y_planes_de_mitigacion.

    exclude Gestion_contable_facturacion.
    exclude Diseno_estructural_detallado.
  }

  schedule {
    phase Levantamiento_requerimientos        start 2025_11_25 end 2025_12_10
    phase Diseno_arquitectura_software        start 2025_12_11 end 2026_01_15
    phase Desarrollo_MVP                      start 2026_01_16 end 2026_03_30
    phase Pruebas_piloto_con_HE               start 2026_04_01 end 2026_04_30
  }

  team {
    role Product_Owner      Arq_Natalia_Rubio
    role Scrum_Master       Juan_Pablo_Castaneda
    role Full_Stack_Dev     Est_Ing_Sistemas_A
    role Full_Stack_Dev     Est_Ing_Sistemas_B
  }

  risks {
    risk Sobrecarga_trabajo_academico                 level high   mitigation Planificar_sprints_y_priorizar_entregables_criticos.
    risk Cambios_en_requerimientos_del_cliente        level medium mitigation Reuniones_quincenales_revision_y_ajuste_backlog.
    risk Falta_de_adopcion_por_usuarios_finales       level medium mitigation Capacitaciones_y_manuales_claros_en_la_plataforma.
  }

  budget {
    currency COP
    item Infraestructura_nube_AWS                     cost 500000
    item Herramientas_colaboracion_Jira_GitHub        cost 200000
    item Capacitaciones_y_documentacion               cost 150000
  }

  status {
    overall  En_planificacion_inicial.
    health   En_verde_alcance_y_tiempos_bajo_control.
    comments Pendiente_validacion_final_del_acta_con_HE_Arquitectos.
  }

  approvals {
    required_by 2025_11_30
    approver Gerente_HE_Arquitectos    Firma_pendiente
    approver Director_Prog_Ing_Sistemas Revision_academica_pendiente
  }
}
